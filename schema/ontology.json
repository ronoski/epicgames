{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epicgames-recon/schema/ontology.json",
  "title": "Recon knowledge-graph ontology (closed type registry)",
  "schema_version": "0.1.0",
  "description": "The closed set of node and edge types. The autonomous loop cannot use a type absent from this registry; a new type must be added to proposed_additions and promoted by a human.",
  "node_types": {
    "Organization": {
      "id": "org:<slug>",
      "desc": "Top-level owner"
    },
    "BusinessUnit": {
      "id": "bu:<slug>",
      "desc": "Acquisition / product line"
    },
    "Domain": {
      "id": "domain:<registrable>",
      "desc": "Registrable domain / apex"
    },
    "DNSName": {
      "id": "dns:<fqdn>",
      "desc": "Hostname + records"
    },
    "NetBlock": {
      "id": "net:<cidr>",
      "desc": "IP range"
    },
    "ASN": {
      "id": "asn:<n>",
      "desc": "Autonomous system"
    },
    "Host": {
      "id": "host:<ip>",
      "desc": "Resolved IP endpoint"
    },
    "Service": {
      "id": "svc:<ip>:<port>/<proto>",
      "desc": "Listening service"
    },
    "WebApp": {
      "id": "web:<scheme>://<authority>",
      "desc": "Virtual host / web application; authority retains a non-default port"
    },
    "Route": {
      "id": "route:<webapp>/<template>",
      "desc": "Path template"
    },
    "Operation": {
      "id": "op:<method>:<route>",
      "desc": "Typed API operation"
    },
    "Parameter": {
      "id": "param:<op>#<location>:<name>",
      "desc": "A typed input; location is part of the identity so query/header/body parameters of the same name do not collide"
    },
    "AuthScheme": {
      "id": "auth:<id>",
      "desc": "Auth mechanism"
    },
    "Credential": {
      "id": "cred:<hash>",
      "desc": "Client id / key (mapping fact)"
    },
    "Token": {
      "id": "tok:<hash>",
      "desc": "Token shape / issuer (never plaintext secret)"
    },
    "ObjectType": {
      "id": "obj:<name>",
      "desc": "Data object / identifier type"
    },
    "Flow": {
      "id": "flow:<slug>",
      "desc": "Multi-step process (state machine)"
    },
    "Artifact": {
      "id": "art:<sha256>",
      "desc": "Binary/APK/JS/manifest/repo/package"
    },
    "Evidence": {
      "id": "ev:<sha256>[:region]",
      "desc": "Content-addressed raw proof"
    },
    "Hypothesis": {
      "id": "hyp:<kind>:<slug>",
      "desc": "Testable, non-actioned lead"
    },
    "Certificate": {
      "id": "cert:<spki_sha256>",
      "desc": "A served X.509 certificate, keyed by SPKI hash (enables key-reuse clustering)"
    }
  },
  "edge_types": [
    "attributed_to",
    "authenticates_with",
    "calls",
    "cname_to",
    "contradicts",
    "corroborates",
    "derived_from",
    "evidenced_by",
    "exposes",
    "fronted_by",
    "grants",
    "hosted_on",
    "in_netblock",
    "issued_by",
    "presents_certificate",
    "references_object",
    "resolves_to",
    "step_of",
    "subdomain_of",
    "takes",
    "vhost_of"
  ],
  "proposed_additions": {
    "note": "Declared but NOT usable until a human promotes them. Until then, record only as typed corroborates/contradicts evidence.",
    "edges": [
      "originated_by (NetBlock->ASN)",
      "same_as",
      "co_deploy",
      "shared_trust_domain",
      "allows_origin (WebApp->Origin)"
    ],
    "nodes": [
      "Origin (required before allows_origin can be promoted)"
    ]
  },
  "naming_rules": {
    "ownership_edge": "attributed_to (never owned_by)",
    "bgp_origin_edge": "originated_by (never announced_by)",
    "containment_edge": "derived_from (never part_of)",
    "dns_containment_edge": "subdomain_of (DNSName->Domain); derived_from stays Artifact-only per invariant I5",
    "certificate_edge": "presents_certificate (WebApp->Certificate)"
  },
  "invariants_ref": "../docs/safety-model.md#9-machine-checkable-invariants-ci-over-the-data",
  "canonicalization": "All ids are built by recon/urls.py \u2014 the single source of truth for host, authority, path-template and id construction (SPEC.md 3.1)"
}
